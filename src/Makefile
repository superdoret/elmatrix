# Run `make help`. Everything is built/installed inside src/ (no system changes).
PYTHON  ?= python3
HARDWARE_DESC ?= adafruit-hat
MATRIX_LIB := libs/matrix/lib
PKG_DIR := libs/site-packages

.PHONY: help all deps build cython run simulate clean distclean

help:
	@echo "make deps       Install pip dependencies into libs/site-packages"
	@echo "make build      Compile the C++ library and the Python bindings (on the Raspberry Pi)"
	@echo "make all        deps + build"
	@echo "make cython     Regenerate libs/rgbmatrix/*.cpp from *.pyx (done automatically by build)"
	@echo "make run        sudo python3 main.py  (real panel)"
	@echo "make simulate   Run on-screen simulator (no hardware, no sudo)"
	@echo "make clean      Remove build products"

all: deps build

deps:
	$(PYTHON) -m pip install --upgrade --target $(PKG_DIR) -r requirements.txt

$(MATRIX_LIB)/librgbmatrix.a:
	$(MAKE) -C $(MATRIX_LIB) HARDWARE_DESC=$(HARDWARE_DESC)

# The shipped .cpp files were generated by an old Cython that does not compile on
# Python >= 3.12, so `build` always regenerates them with the Cython from `make deps`.
build: $(MATRIX_LIB)/librgbmatrix.a cython
	PYTHONPATH=$(PKG_DIR) $(PYTHON) setup.py build --build-lib libs

cython:
	cd libs/rgbmatrix && for m in core graphics; do PYTHONPATH=../site-packages $(PYTHON) -m cython --cplus -3 -o $$m.cpp $$m.pyx || exit 1; done

run:
	sudo $(PYTHON) main.py

simulate:
	$(PYTHON) simulator/run.py

clean:
	$(MAKE) -C $(MATRIX_LIB) clean
	rm -rf build libs/rgbmatrix/*.so
	find . -name __pycache__ -type d -prune -exec rm -rf {} +

distclean: clean
	rm -rf $(PKG_DIR)
